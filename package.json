{
  "name": "openai-codex-hackathon",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run",
    "contracts:build": "pnpm --filter @openai-codex-hackathon/contracts build",
    "contracts:test": "pnpm --filter @openai-codex-hackathon/contracts test",
    "contracts:typecheck": "pnpm --filter @openai-codex-hackathon/contracts typecheck"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.13",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
